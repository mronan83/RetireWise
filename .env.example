# Database (auto-provisioned via Vercel Marketplace + Neon)
DATABASE_URL=

# Clerk Authentication (auto-provisioned via Vercel Marketplace)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# AI Provider — set ONE of these (first match wins):
#   Anthropic (recommended): https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
#   OpenAI: https://platform.openai.com/api-keys
# OPENAI_API_KEY=
#   Google: https://aistudio.google.com/apikey
# GOOGLE_API_KEY=
#   Vercel AI Gateway (requires credit card on file): https://vercel.com/dashboard/~/ai-gateway/api-keys
# AI_GATEWAY_API_KEY=

# Plaid (create at https://dashboard.plaid.com)
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=production

# Plaid Token Encryption Key (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
PLAID_TOKEN_ENCRYPTION_KEY=

# Cron Secret (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
CRON_SECRET=
