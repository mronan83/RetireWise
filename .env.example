# ── Database ─────────────────────────────────────────────────────────────────
# Supabase Postgres. Use the Supavisor pooler in TRANSACTION mode (port 6543)
# on serverless — the direct connection (port 5432) is IPv6-only on new
# projects. Prepared statements are disabled in src/lib/db/index.ts because the
# transaction-mode pooler cannot hold them.
#   Dashboard → Project Settings → Database → Connection string → Transaction
DATABASE_URL=

# ── Auth (Supabase) ──────────────────────────────────────────────────────────
#   Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy projects expose this as the anon key instead; either name works.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── AI Provider — set ONE of these (first match wins) ────────────────────────
#   Anthropic (recommended): https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
#   OpenAI: https://platform.openai.com/api-keys
# OPENAI_API_KEY=
#   Google: https://aistudio.google.com/apikey
# GOOGLE_API_KEY=
#   Vercel AI Gateway (requires credit card on file)
# AI_GATEWAY_API_KEY=

# ── Plaid (optional — CSV import works without it) ───────────────────────────
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=production
# generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PLAID_TOKEN_ENCRYPTION_KEY=

# ── Redis (optional — price cache + AI rate limiting degrade gracefully) ─────
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# ── Cron ─────────────────────────────────────────────────────────────────────
# generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=

# ── Encryption for user-supplied API keys ────────────────────────────────────
# src/lib/utils/encryption.ts derives its key from ENCRYPTION_KEY, falling back
# to CRON_SECRET. CAUTION: whichever value is in effect when a key is saved is
# the only value that can decrypt it. Setting ENCRYPTION_KEY on a deployment
# that previously relied on CRON_SECRET makes existing saved keys unreadable —
# users would have to re-enter them in Settings. Rotating CRON_SECRET has the
# same effect. Set ENCRYPTION_KEY once, on a clean database, and leave it.
# ENCRYPTION_KEY=

# ── Demo mode ────────────────────────────────────────────────────────────────
# Anything other than the literal "false" leaves demo mode ENABLED, including
# an unset variable. Set it explicitly to disable.
NEXT_PUBLIC_DEMO_ENABLED=false
